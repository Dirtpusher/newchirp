{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "NewChirp (macOS Debug)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "deviceId": "macos",
      "flutterMode": "debug",
      "preLaunchTask": "Update CHIRP source"
    },
    {
      "name": "NewChirp (Linux Debug)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "deviceId": "linux",
      "flutterMode": "debug",
      "preLaunchTask": "Update CHIRP source",
      "env": {
        "PATH": "${workspaceFolder}/.tool/cmake-3.31.6-linux-x86_64/bin:${workspaceFolder}/.tool/bin:${workspaceFolder}/.tool/flutter/bin:${env:PATH}",
        "CHIRP_SOURCE": "${workspaceFolder}/../chirp-20260626"
      }
    },
    {
      "name": "NewChirp (Windows Debug)",
      "type": "dart",
      "request": "launch",
      "program": "lib/main.dart",
      "cwd": "${workspaceFolder}",
      "deviceId": "windows",
      "flutterMode": "debug",
      "env": {
        "CHIRP_SOURCE": "${workspaceFolder}/build_support/chirp-master",
        "NEWCHIRP_PYTHON": "${workspaceFolder}/build_support/cache/python-3.13.15-x86_64/python/python.exe"
      }
    }
  ]
}
