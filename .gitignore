tools/newchirp_scsi_mac

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# OKF lookup caches are large machine-generated indexes with absolute paths.
okf_bundle/.okf_lookup_cache.json
okf_bundle_scripts/.okf_lookup_cache.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
